# Application
APP_NAME=DBZenith
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080
SLOW_QUERY_THRESHOLD_MS=100
TELEMETRY_INTERVAL_SECONDS=30
TELEMETRY_STALENESS_SECONDS=300
# Set ENABLE_DEMO_SEED=false (or DBZENITH_ENABLE_DEMO_SEED=false) in production/staging to disable synthetic demo seeding
ENABLE_DEMO_SEED=true
DBZENITH_ENABLE_DEMO_SEED=true
TELEMETRY_QUERY_LIMIT=500
TELEMETRY_RELATION_LIMIT=100
COLLECT_EXPLAIN=true

# Development PostgreSQL
POSTGRES_DB=dbzenith
POSTGRES_USER=dbzenith
POSTGRES_PASSWORD=<replace-with-postgres-password>
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://dbzenith:<replace-with-postgres-password>@localhost:5432/dbzenith
SANDBOX_DATABASE_URL=postgresql+psycopg://dbzenith_sandbox:<replace-with-sandbox-password>@localhost:5433/dbzenith_sandbox

# Isolated sandbox PostgreSQL
SANDBOX_POSTGRES_DB=dbzenith_sandbox
SANDBOX_POSTGRES_USER=dbzenith_sandbox
SANDBOX_POSTGRES_PASSWORD=<replace-with-sandbox-password>

# Frontend
# Empty = same-origin /api (Vite and nginx proxy to the backend).
VITE_API_BASE_URL=

# Optimization simulation safety limits
SIMULATION_MAX_ROWS_PER_TABLE=25000
SIMULATION_MAX_TIMEOUT_MS=30000
SIMULATION_MAX_BENCHMARK_RUNS=5

# Security, Authentication & Rate Limiting
SECRET_KEY=<replace-with-strong-random-256-bit-hmac-secret-key>
TOKEN_TTL_SECONDS=86400
API_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# Optional Bootstrap Operator Passwords (used only when seeding initial demo accounts)
BOOTSTRAP_ADMIN_PASSWORD=<replace-with-bootstrap-admin-password>
BOOTSTRAP_DBA_PASSWORD=<replace-with-bootstrap-dba-password>
BOOTSTRAP_ANALYST_PASSWORD=<replace-with-bootstrap-analyst-password>
BOOTSTRAP_VIEWER_PASSWORD=<replace-with-bootstrap-viewer-password>
